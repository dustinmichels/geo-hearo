{
  "name": "geo-hearo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "optimize-geo": "mapshaper public/data/ne_countries.geojson -o force precision=0.001 public/data/ne_countries.geojson",
    "minify": "find public/data -type f \\( -name '*.json' -o -name '*.geojson' \\) -exec sh -c 'jq -c . \"$1\" > \"$1.tmp\" && mv \"$1.tmp\" \"$1\"' _ {} \\;",
    "show-size": "ls -lh public/data",
    "prebuild": "bun run show-size && bun run optimize-geo && bun run minify && bun run show-size"
  },
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.7",
    "@supabase/postgrest-js": "^2.119.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/explode": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "driver.js": "^1.11.0",
    "lucide-vue-next": "^0.562.0",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "vant": "^4.10.2",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.8.1",
    "mapshaper": "^0.6.121",
    "oxfmt": "^0.40.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
