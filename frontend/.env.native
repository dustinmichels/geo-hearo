# index are fetched from the live site instead of being bundled.
VITE_REMOTE_DATA_BASE=https://geohearo.com

# Same public values as netlify.toml [build.environment], so a clean checkout
# builds the app without a local .env.
VITE_SUPABASE_URL=https://hxxfyqgcnukpravehjqz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RJwfAkOncFJeAGkvi9Z0oQ_8OTbcrbJ

# Store builds are made locally: override any debug values from .env.
VITE_DEBUG_MODE=false
VITE_SECRET_COUNTRY=
